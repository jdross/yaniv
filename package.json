{
  "name": "yaniv",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:frontend && npm run test:server && npm run test:node",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:server": "node --test tests/server/*.test.js",
    "test:node": "node --test tests/*.test.js",
    "test:node:integration": "RUN_LEARNED_INTEGRATION=1 node --test tests/learned_training.test.js",
    "dev": "node server/src/server.js",
    "start": "NODE_ENV=production node server/src/server.js",
    "server:install": "npm install",
    "server:dev": "npm run dev",
    "server:start": "npm run start",
    "learned:run": "node scripts/learned_ai.js run",
    "learned:burst": "node scripts/learned_ai.js burst",
    "learned:generate": "node scripts/learned_ai.js generate",
    "learned:train": "node scripts/learned_ai.js train",
    "learned:evaluate": "node scripts/learned_ai.js evaluate",
    "learned:promote": "node scripts/learned_ai.js promote",
    "learned:plot": "node scripts/learned_ai.js plot",
    "learned:python:run": "node scripts/learned_ai_python.js run",
    "learned:python:loop": "./scripts/run_python_training_loop.sh",
    "learned:python:promote": "node scripts/learned_ai_python.js promote",
    "learned:python:train": "node scripts/learned_ai_python.js train",
    "learned:python:setup": "python3 -m venv .venv-ml && . .venv-ml/bin/activate && python -m pip install --upgrade pip setuptools wheel && python -m pip install -r python-server/requirements-ml.txt",
    "benchmark:ai": "node scripts/benchmark.js"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
